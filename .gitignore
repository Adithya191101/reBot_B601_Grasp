# upstream sources — pinned in upstream.repos, restore with:
#   vcs import src < upstream.repos
/src/

# ROS 2 workspace build artifacts
build/
install/
log/

# recorded datasets and generated artifacts — regenerate with ./run_smoke.sh
bags/
data/

# artifacts/ is generated, EXCEPT the two canonical acceptance records. Those are
# the evidence for P0 and P2 and must survive a clean checkout; everything else
# (datasets, overlays, superseded runs) is reproducible and stays out.
artifacts/*
!artifacts/main_goal/
artifacts/main_goal/*
!artifacts/main_goal/b601_asset_probe.json
!artifacts/b601_pick/
artifacts/b601_pick/*
!artifacts/b601_pick/b601_pick.json
!artifacts/b601_pick/p3_move_to_traj.json
!artifacts/urdf_import/
artifacts/urdf_import/*
!artifacts/urdf_import/with_gripper.json
!artifacts/hand_eye/
artifacts/hand_eye/*
!artifacts/hand_eye/b601_hand_eye.json
!artifacts/render_exp/
artifacts/render_exp/*
!artifacts/render_exp/dm-usd_none.json
!artifacts/render_exp/urdf_none_v2.json
!artifacts/render_exp/dm-usd_writeback_v2.json
!artifacts/render_exp/dm-usd_native.json
!artifacts/render_exp/urdf_force.json
!artifacts/render_exp/urdf_joints.json
!artifacts/banana/
artifacts/banana/*
!artifacts/banana/b601_banana.json
*.mp4
*.mcap
*.db3
*.npy
*.png
!docs/**/*.png

