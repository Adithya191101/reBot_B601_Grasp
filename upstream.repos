# vcstool manifest — pinned upstream sources for this project.
#   vcs import src < upstream.repos
# Pinned to the commits verified on 2026-08-04. Bump deliberately, not incidentally:
# facts in PLAN.md (ros2_control plugin, gripper joint types, YOLO mask/OBB usage) were
# read from these exact trees.
repositories:
  reBot-DevArm-Grasp:
    type: git
    url: https://github.com/Seeed-Projects/reBot-DevArm-Grasp.git
    version: 547faa08e5161af996892497c0aaa788401454fc
  reBotArmController_ROS2:
    type: git
    url: https://github.com/Seeed-Projects/reBotArmController_ROS2.git
    version: 39fbea54c7235b1c38bd025fc2e7308e42bd2fbe
  reBot-Isaacsim:
    type: git
    url: https://github.com/Seeed-Projects/reBot-Isaacsim.git
    version: c3ee253ca113ea3514da442684ef5d4894219374
  # The demo's motion layer. reBot-DevArm-Grasp/README.md:122 clones exactly this
  # URL into sdk/, and drivers/robot/grasp_driver.py:136 imports
  # reBotArm_control_py.kinematics. It defines move_to_traj / open_gripper /
  # grasp / get_tcp_pose -- the entire robot interface the demo uses -- on
  # Pinocchio IK, with no ROS, MoveIt or cuMotion anywhere. It was the one repo
  # that defines the goal's control path and the one repo that was not pinned.
  reBotArm_control_py:
    type: git
    url: https://github.com/vectorBH6/reBotArm_control_py.git
    version: 40ab6ce58fec3c58cb603efb3f30240d6f5849e4
